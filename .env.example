# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is ignored by git. Never commit real passwords or tokens.

# --- Database --------------------------------------------------------------
POSTGRES_USER=coursemgmt
POSTGRES_PASSWORD=coursemgmt
POSTGRES_DB=coursemgmt
# Port on YOUR machine where Postgres is exposed. Change it if 5432 is taken.
POSTGRES_PORT=5432

# --- Superuser ---------------------------------------------------------------
# Created automatically the first time the API starts. Log in with these.
# Changing the password here later does NOT change an existing account; see
# docs/authentication.md ("Resetting a password").
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-please

# --- Sessions ----------------------------------------------------------------
# How long a login lasts, in hours (default: 7 days).
SESSION_TTL_HOURS=168
# Set to true when serving the site over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Invitations -------------------------------------------------------------
# How long a one-time invite link stays valid, in hours (default: 7 days).
INVITE_TTL_HOURS=168

# --- Encryption --------------------------------------------------------------
# Encrypts the API keys and tokens people save in the app. The value below is
# fine for local development. In production, generate a long random value, e.g.:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and keep it secret. If it changes, saved API keys can no longer be read and
# must be entered again. API keys themselves (GitHub, Linear, Anthropic, ...)
# are NOT set here: add them in the app (Account > API keys, or
# System settings for app-wide keys).
APP_SECRET_KEY=dev-only-insecure-secret-key-change-me
